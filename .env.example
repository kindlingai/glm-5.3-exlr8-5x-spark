# GLM-5.3 on five DGX Sparks (983K context). Copy to .env next to compose.yaml on every box: the
# same file on all five. Compose passes each line into the container, where gr8's launcher reads it as an option
# (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option).
#
# Set PEERS. Leave the rest as it is: every line under "983K context" below is a setting of the measured serve.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# The release, pinned to the Hugging Face commit (v0.6, bit325 width profile) the README's numbers were measured with.
# The model cache is keyed by commit, so a new commit on the repo changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@3e388b45b26ca4558351d22994afcfc85b99af74
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of each of the five boxes, in rank order, the same line on every box. The first is the head
# (OpenAI API on port 8100). The boxes are on a switch (SHAPE=mesh): a ring needs TP=3 or 4.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4,192.0.2.5
TP=5
SHAPE=mesh

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model and the QO cache (13 GB), owned by uid 1000. Make it and its
# qocache directory before the first boot (README.md, Quickstart): the engine does not create qocache, and without it
# no cache is written and every boot is a slow one.
GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home

# --- 983K context: the settings of the measured serve (gr8 v1.1.0) ---------------------------------------------------
# PF_OWN=3 with QO_CACHE: the first boot writes the cache, later boots read it (~60 s to /health). The path is
# inside the container: GR8_CACHE/qocache on the host.
QO_CACHE=/var/lib/gr8/cache/qocache
READY_TMO=1800
KV_FORMAT=int4
KVB=bf16
# int4 KV: CAP 983040 (3,481 physical pages/rank, max_model_len 983,034) with 8 concurrent sessions.
CAP=983040
SHARE_LIMIT=32768
SESS=8
REUSE=1
REUSE_GRID=64
# MTP=3 drafting with confidence stopping (DFlash2 does not split 5 ways).
MTP=3
DFLASH=0
SPEC_ADAPT=0
SPEC_ACCEPT=rejection
MTP_LASTROW=1
DRAFT_HEAD_I4=1
DRAFT_HEAD2=1
MTP_KSTOP=1
MTP_KSTOP_KMAX=3
MTP_KSTOP_TAU=0,0.5,0.75
MTP_KSTOPB=1
MTP_KSTOPB_TAU_S=2:0.7,0.8,0.9/3:0.7,0.88,0.95/4:0.7,0.75,0.9
MTP_KSTOPB_WIDTHS=2,3,5,6,7,9,10,11,13,14,15
L2PF=31
MTP_L2PF=3
PF_OWN=3
PF_GEMMF32=1
PF_SELX_CTX=53248
DEC_BK=2048
DEC_BK_MAX=2048
TR3_W2ALL=1
ROUTE_OVL=1
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=2
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
IDX_VEC=1
S2_ADAPT=1
S2_DECODE_PF=4096
S2_ADMIT_HOLD=1
KV4_SC=4
KV4_SC_TR=2
KV4_QT=1
KV4_CTX=2
KV4_FUSE_ROT=1
KV4_FOLD=1
KV4_TC=1
# Bit-exact v1.1.0 decode & prefill kernels (KL = 0.00000).
DEC_DENSE_OPT=1
DTR_EXACT_OPT=1
MOE_RTR_FIN_OPT=1
TR3_WIDE4=1
PF_ATTN_OPT=1
PF_DENSE_OPT=1
PF_ISGRT_CLEAN=1
# Speed / quality preset (MoE expert union cap across concurrent tokens in a decode step):
#   48 (default): Quality preset (68.9 tok/s code, 104.2 tok/s at 4 streams, 141.5 tok/s at 8 streams).
#   32:           Fast preset (69.3 tok/s code, 119.6 tok/s at 4 streams, 160.5 tok/s at 8 streams).
#   0:            Uncapped exact (strict KL=0.00000: 69.2 tok/s code, 89.5 at 4 streams, 110.5 at 8 streams).
MOE_UNION_CAP=48
EXTRA_ENV="GR8_QUIT_FAST=1 GR8_K1_SPLIT=1:/4,2-3:2x1,4-32:8x1/4 GR8_K1_TLBW=2048"

# --- option: a remote KV store on a sixth Spark (experimental) -------------------------------------------------------
# The sixth box runs `gr8 kv up --gb 106` and keeps evicted chats' KV in its RAM; a chat that comes back reads its
# blocks over RDMA instead of a new prefill. README.md, "Option: remote KV", has what was measured and what was not.
#KV_STORE=remote:192.0.2.6:7350,size=21G
#KV_KEEP=sessions
