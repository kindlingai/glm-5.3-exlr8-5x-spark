# GLM-5.3 on five DGX Sparks, the T5X settings (737K context). Copy to .env next to compose.yaml on every box: the
# same file on all five. Compose passes each line into the container, where gr8's launcher reads it as an option
# (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option).
#
# Set PEERS. Leave the rest as it is: every line below the "T5X" mark is a setting of the measured serve.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of each of the five boxes, in rank order, the same line on every box. The first is the head
# (OpenAI API on port 8100). The boxes are on a switch (SHAPE=mesh): a ring needs TP=3 or 4.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4,192.0.2.5
TP=5
SHAPE=mesh

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model and the QO cache (13 GB), owned by uid 1000. Make it and its
# qocache directory before the first boot (README.md, Quickstart): the engine does not create qocache, and without it
# no cache is written and every boot is a slow one.
GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home

# --- T5X: the settings of the measured serve -------------------------------------------------------------------------
# PF_OWN=3 with QO_CACHE: the first boot writes the cache (99-104 s to /health), later boots read it (30 s). The path is
# inside the container: GR8_CACHE/qocache on the host.
QO_CACHE=/var/lib/gr8/cache/qocache
PROXY_CPU=19
S2PORT=7341
MTP=2
NOHASH=0
READY_TMO=1800
EXTRA_ENV="GR8_DEC_BK=512 GR8_IDX_VEC=1 GR8_S2_ADAPT=1 GR8_DEC_EVPROF=0 GR8_PF_SELX_CTX=53248 GR8_TR3_W2ALL=1 GR8_S2_DECODE_PF=4096 GR8_S2_ADMIT_HOLD=1 GR8_S2_DECODE_ROUNDS=16 GR8_K1_TLBW=2048 GR8_KV4_SC=4 GR8_KV4_SC_TR=2 GR8_KV4_QT=1 GR8_KV4_CTX=2 GR8_KV4_FUSE_ROT=1"
PF_ISGRT_RG=32
PF_ATTN_ROWS=512
PF_GEMMF32=1
ATTN_P11=0
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=4
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
ROUTE_OVL=1
DRAFT_HEAD_I4=1
DTR=1
PF_AOP=0
SHARE_LIMIT=4096
SESS=4
KVB=fp8
DFLASH=0
SPEC_ADAPT=0
PF_OWN=3
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
# int4 KV: CAP 737280 = 11520 pages of 64 tokens (max_model_len 737276).
KV_FORMAT=int4
CAP=737280
# Roll back to fp8 KV (max_model_len 617532): uncomment the two lines below.
# (The fp8 engine does not read the GR8_KV4_* entries in EXTRA_ENV.)
#KV_FORMAT=fp8
#CAP=617536

# --- option: a remote KV store on a sixth Spark (experimental) -------------------------------------------------------
# The sixth box runs `gr8 kv up --gb 106` and keeps evicted chats' KV in its RAM; a chat that comes back reads its
# blocks over RDMA instead of a new prefill. README.md, "Option: remote KV", has what was measured and what was not.
#KV_STORE=remote:192.0.2.6:7350,size=21G
#KV_KEEP=sessions
